<?xml version="1.0" encoding="utf-8"?>
<!-- Installer (Java) is the launcher: it unpacks the player's disc on first run, then starts the
     NativeActivity, which runs the game (native code). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="net.vt3port.game"
    android:versionCode="2"
    android:versionName="0.2.0">
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" android:version="1" />
    <application android:label="VT3" android:icon="@mipmap/ic_launcher" android:hasCode="true" android:debuggable="true">
        <activity android:name="net.vt3port.game.Installer"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="android.app.NativeActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout"
            android:screenOrientation="sensorLandscape">
            <meta-data android:name="android.app.lib_name" android:value="vt3android" />
        </activity>
    </application>
</manifest>
